# deploy/.env.example — salin ke deploy/.env lalu isi. JANGAN commit deploy/.env.

# Domain untuk HTTPS otomatis (DNS A record harus sudah menunjuk ke IP VPS).
# Untuk uji tanpa domain, biarkan ":80" (HTTP saja).
DOMAIN=:80

# Password database (buat acak & kuat, mis. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Kunci penanda token login (acak, minimal 32 karakter, mis. `openssl rand -hex 32`).
JWT_SECRET=

# Akun admin pertama (hanya dibuat bila database masih kosong).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Nama branch pertama (hanya dipakai saat bootstrap database kosong).
ADMIN_BRANCH_KODE=HQ
ADMIN_BRANCH_NAMA=Kantor Pusat

# Port frontend di localhost (dipakai reverse proxy host). Pastikan belum dipakai layanan lain.
WEB_PORT=8580

# Opsional (profil https saja): ganti port host (mis. saat uji lokal). Produksi biarkan default.
# HTTP_PORT=80
# HTTPS_PORT=443
